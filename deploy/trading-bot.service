# Servicio systemd para tener el bot funcionando 24/7 en un servidor Linux (VPS, Raspberry Pi...).
#
# Instalación (cambia "usuario" y la ruta por los tuyos):
#   sudo cp deploy/trading-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now trading-bot
#
# Uso:
#   systemctl status trading-bot        # ¿está funcionando?
#   journalctl -u trading-bot -f        # ver el log en directo
#   sudo systemctl restart trading-bot  # tras cambiar config.py o .env
#   sudo systemctl stop trading-bot     # pararlo

[Unit]
Description=Bot de trading cruce de medias (Binance)
After=network-online.target
Wants=network-online.target

[Service]
User=usuario
WorkingDirectory=/home/usuario/trading-bot
ExecStart=/home/usuario/trading-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
