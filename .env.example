# Lo normal es NO editar este archivo a mano: el asistente del panel (⚙ Configuración)
# crea el archivo .env y guarda aquí el modo y tus claves. NUNCA compartas el .env.

# paper = simulado (no necesita claves) | live = real (o testnet si TESTNET=true)
MODE=paper
TESTNET=false

# Claves de API: una pareja por exchange (y otra para su testnet). Ejemplos:
#   BINANCE_API_KEY= / BINANCE_API_SECRET=
#   BINANCE_TESTNET_API_KEY= / BINANCE_TESTNET_API_SECRET=
#   KRAKEN_API_KEY= / KRAKEN_API_SECRET=
#   OKX_API_KEY= / OKX_API_SECRET= / OKX_API_PASSWORD=   (la "passphrase")
# Permisos: solo lectura y trading spot. NUNCA retiros.

# Opcional: avisos por Telegram (crea un bot con @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: puerto del panel (http://127.0.0.1:8765). Cámbialo solo si ese puerto está ocupado.
# PANEL_PORT=8765
