# Copia este archivo como .env y rellénalo. NUNCA lo compartas ni lo subas a GitHub.

# paper = simulado (no necesita claves) | live = dinero real
MODE=paper

# true = usa la testnet de Binance (dinero ficticio, necesita claves de testnet.binance.vision)
TESTNET=false

# Claves de API de Binance (solo para MODE=live o testnet)
# Al crearlas: activa SOLO "Enable Spot & Margin Trading". NUNCA actives retiros (Withdrawals).
# Restringe el acceso a la IP de tu servidor si puedes.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Opcional: avisos por Telegram (crea un bot con @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: puerto del panel (http://127.0.0.1:8765). Cámbialo solo si ese puerto está ocupado.
# PANEL_PORT=8765
